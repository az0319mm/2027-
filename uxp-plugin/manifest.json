{
  "manifestVersion": 5,
  "id": "kr.graduation2027.psdcleanup",
  "name": "PSD 졸업작품 클린업",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cleanupPanel",
      "label": {
        "default": "PSD 클린업"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "maximumSize": {
        "width": 900,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765"
      ]
    },
    "localFileSystem": "fullAccess"
  },
  "icons": []
}